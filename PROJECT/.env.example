# development | test | production — decide anche il livello di log (debug | silent | info)
NODE_ENV=development
PORT=3000
# Origini ammesse da CORS, separate da virgola
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Opzionale: sovrascrive il livello di log derivato da NODE_ENV (trace|debug|info|warn|error|fatal|silent)
# LOG_LEVEL=info
# Postgres del G0 (docker-compose in bootcamp/node: container liparibank-db)
DATABASE_URL="postgresql://liparibank:liparibank_dev_2026@localhost:5432/liparibank_digital?schema=public"

# Secret JWT (OBBLIGATORI: senza, l'app non parte). Uno diverso per ogni ambiente, minimo 32 caratteri.
# Generare con: openssl rand -base64 64
JWT_SECRET=
JWT_REFRESH_SECRET=
